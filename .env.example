# Local Docker defaults
POSTGRES_DB=humanos
POSTGRES_USER=humanos
POSTGRES_PASSWORD=humanos_dev_password
DATABASE_URL=postgresql+psycopg://humanos:humanos_dev_password@postgres:5432/humanos

# API
OPENAI_API_KEY=replace-me
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:3000,http://0.0.0.0:3000
CORS_ORIGIN_REGEX=
ADMIN_EMAILS=assaditya.iit@gmail.com
MCP_API_KEY=change-this-long-random-integration-key

# Web
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_JWT_AUDIENCE=

# Vector database
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=humanos_memories
QDRANT_DOCUMENT_COLLECTION=humanos_documents
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_ENTERPRISE=

# Razorpay subscriptions (recommended for India production payments)
RAZORPAY_KEY_ID=rzp_test_or_live_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_PLAN_STARTER=plan_xxxxx_starter
RAZORPAY_PLAN_PRO=plan_xxxxx_pro
RAZORPAY_PLAN_PREMIUM=plan_xxxxx_premium
RAZORPAY_PLAN_ENTERPRISE=
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_or_live_key_id
